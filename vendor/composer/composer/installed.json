            },
            "require": {
                "php": ">=7.2"
            },
            "type": "library",
            "installation-source": "dist",
            "autoload": {
                "files": [
                    "bootstrap.php"
                ],
                "psr-4": {
                    "Symfony\\Polyfill\\Ctype\\": ""
                }
            },
            "install-path": "../symfony/polyfill-ctype"
        },
        {
            "name": "symfony/polyfill-mbstring",
            "version": "v1.37.0",
            "version_normalized": "1.37.0.0",
            "dist": {
                "type": "zip",
                "url": "https://codeload.github.com/symfony/polyfill-mbstring/zip/refs/tags/v1.37.0"
