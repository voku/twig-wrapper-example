<!DOCTYPE html>
<html lang="{{ globalArray['language'] }}" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ globalArray['title'] }}</title>
  <meta name="description" content="{{ globalArray['description'] }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="{{ globalArray['site'] }}">
  <meta name="twitter:title" content="{{ globalArray['title'] }}">
  <meta name="twitter:description" content="{{ globalArray['description'] }}">
  <meta name="twitter:image" content="{{ globalArray['image'] }}">
  <meta property="og:title" content="{{ globalArray['title'] }}">
  <meta property="og:description" content="{{ globalArray['description'] }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ globalArray['canonical'] }}">
  <meta property="og:image" content="{{ globalArray['image'] }}">
  <meta property="og:site_name" content="{{ globalArray['myName'] }}">
  <link rel="stylesheet" href="css/app.css">
  <link rel="shortcut icon" href="images/favicon.ico" type="image/x-icon">
</head>
<body class="page-home">
  <nav class="navbar navbar-expand-lg border-bottom border-white border-opacity-10 bg-body-tertiary bg-opacity-75 sticky-top backdrop-blur">
    <div class="container py-2">
      <a class="navbar-brand fw-semibold" href="#top">Twig Wrapper Example</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#site-nav" aria-controls="site-nav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div id="site-nav" class="collapse navbar-collapse">
        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
          {% for item in navigation %}
            <li class="nav-item">
              <a class="nav-link" href="{{ item.href }}"{% if item.external|default(false) %} target="_blank" rel="noreferrer"{% endif %}>{{ item.label }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </nav>

  {% block carousel %}
    {% include 'inc_carousel.twig' %}
  {% endblock %}

  <main class="container py-5">
    {% block layout %}{% endblock %}

    <footer class="border-top border-white border-opacity-10 pt-4 mt-5 d-flex flex-column flex-md-row justify-content-between gap-2 small text-secondary">
      <p class="mb-0">&copy; {{ "now" | date("Y") }} twig-wrapper-example</p>
      <p class="mb-0">Classic API, modern internals.</p>
    </footer>
  </main>

  <script src="js/app.pkgd.js" defer></script>
</body>
</html>
